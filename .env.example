# Kopiera till .env lokalt. Produktionens värden sätts i driftsmiljön, aldrig här.
SECRET_KEY=byt-mot-en-lang-slumpad-strang
# Masterdatabasen (bolagsregistret). Lokalt räcker SQLite; dev och prod kör PostgreSQL i Azure.
MASTER_DATABASE_URL=sqlite:///instance/master.db
# Microsoft-inloggning (driftsattning.md steg 1). Utan dem visas bara reservkontot.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# Lokalt över http (inte i drift): kakorna kräver annars https.
SESSION_COOKIE_SECURE=0
# TOTP_KEY=   egen Fernet-nyckel för engångskoderna; annars härledd ur SECRET_KEY
# PDF_LOG_REQUESTS=0   stänger av loggraden per anrop
